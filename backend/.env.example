# Servidor
PORT=3000
NODE_ENV=development

# SQL Server
DB_SERVER=LAPTOPVALE
DB_DATABASE=BD_BBVA
DB_AUTH_TYPE=windows
DB_ODBC_DRIVER=ODBC Driver 18 for SQL Server
DB_ENCRYPT=false
DB_TRUST_CERT=true

# Si prefieres SQL Auth, cambia DB_AUTH_TYPE=sql y descomenta:
# DB_PORT=1433
# DB_USER=sa
# DB_PASSWORD=TuPasswordSQL123!

# Si tu instancia necesita una cadena exacta, puedes usar:
# DB_CONNECTION_STRING=Driver={ODBC Driver 18 for SQL Server};Server=LAPTOPVALE;Database=BD_BBVA;Trusted_Connection=Yes;TrustServerCertificate=Yes;

# JWT
JWT_SECRET=bbva_fake_jwt_secret_2024_muy_seguro
JWT_EXPIRES_IN=8h
